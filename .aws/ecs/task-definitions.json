{
  "schema_version": 1,
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile",
    "args": {}
  },
  "migration": {
    "target": "users-web",
    "container_name": "users-web",
    "command": [
      "sh",
      "-c",
      "python manage.py migrate"
    ]
  },
  "targets": {
    "users-web": {
      "family": "interaims-dev-users-web",
      "taskRoleArn": "arn:aws:iam::220979325244:role/interaims-dev-ecs-task",
      "executionRoleArn": "arn:aws:iam::220979325244:role/interaims-dev-ecs-execution",
      "networkMode": "awsvpc",
      "containerDefinitions": [
        {
          "name": "users-web",
          "image": "__IMAGE_URI__",
          "cpu": 0,
          "portMappings": [
            {
              "containerPort": 7001,
              "hostPort": 7001,
              "protocol": "tcp"
            }
          ],
          "essential": true,
          "command": [
            "sh",
            "-c",
            "python manage.py migrate && python manage.py runserver 0.0.0.0:7001"
          ],
          "environment": [],
          "mountPoints": [],
          "volumesFrom": [],
          "systemControls": []
        },
        {
          "name": "users-consumer",
          "image": "__IMAGE_URI__",
          "cpu": 0,
          "portMappings": [],
          "essential": true,
          "command": [
            "sh",
            "-c",
            "python manage.py consume_kafka"
          ],
          "environment": [],
          "mountPoints": [],
          "volumesFrom": [],
          "systemControls": []
        },
        {
          "name": "users-outbox",
          "image": "__IMAGE_URI__",
          "cpu": 0,
          "portMappings": [],
          "essential": true,
          "command": [
            "sh",
            "-c",
            "python manage.py publish_outbox_events"
          ],
          "environment": [],
          "mountPoints": [],
          "volumesFrom": [],
          "systemControls": []
        },
        {
          "name": "users-mcp",
          "image": "__IMAGE_URI__",
          "cpu": 0,
          "portMappings": [
            {
              "containerPort": 8000,
              "hostPort": 8000,
              "protocol": "tcp"
            }
          ],
          "essential": true,
          "command": [
            "sh",
            "-c",
            "python -m mcp_server.server"
          ],
          "environment": [],
          "mountPoints": [],
          "volumesFrom": [],
          "systemControls": []
        }
      ],
      "requiresCompatibilities": [
        "FARGATE"
      ],
      "cpu": "512",
      "memory": "2048",
      "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
      }
    }
  }
}
