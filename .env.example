# ==============================
# Core Django
# ==============================
SECRET_KEY=change-me-to-a-strong-random-value
DEBUG=True
LOCAL_SERVER=True
ALLOWED_HOSTS=localhost,127.0.0.1,dev.accounts.interaims.com,accounts.interaims.com,users.interaims.com,users.mcp.interaims.com,host.docker.internal
USERS_MCP_ALLOWED_HOSTS=users.mcp.interaims.com,users.interaims.com,accounts.interaims.com,dev.accounts.interaims.com
USERS_MCP_ALLOWED_ORIGINS=https://users.mcp.interaims.com,https://dev.interaims.com,https://www.interaims.com,http://localhost:3000

# ==============================
# Database (used when LOCAL_SERVER=False)
# ==============================
DB_NAME=intera_users
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ==============================
# Email (Djoser activation/reset)
# ==============================
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
COMPANY_INVITATION_EXPIRY_DAYS=2
# Site URL used for backend-originated email links when no frontend override is provided.
SITE_URL=http://localhost:8000
# Frontend URL used for invitations, support access, and email redirects.
FRONTEND_SITE_URL=http://localhost:3000
# Optional explicit invitation page template. `{code}` is replaced with the invitation code.
# Leave blank to use FRONTEND_SITE_URL + /accounts/invitations/{code}
COMPANY_INVITATION_ACCEPT_URL_TEMPLATE=

# ==============================
# JWT (RS256/ES256 recommended)
# ==============================
JWT_ALGORITHM=RS256
# Use either *_PATH or raw PEM values below.
JWT_PRIVATE_KEY_PATH=/absolute/path/to/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/absolute/path/to/jwt_public.pem
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Optional JWT validation metadata
JWT_AUDIENCE=
JWT_ISSUER=
JWT_JWK_URL=

# ==============================
# Cookie / session security
# ==============================
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER_ENABLED=False

# ==============================
# API throttling / CORS
# ==============================
ANON_RATE_LIMIT=20/minute
USER_RATE_LIMIT=120/minute
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8001,https://dev.accounts.interaims.com,https://accounts.interaims.com

# Comma-separated redirect URIs for social auth callbacks
SOCIAL_AUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback/google,http://localhost:3000/auth/callback/facebook

# ==============================
# Profile agent secret encryption (required)
# Same Fernet key should also be configured in kafka_a2a for decryption.
# Generate with:
# python - <<'PY'
# from cryptography.fernet import Fernet
# print(Fernet.generate_key().decode())
# PY
# ==============================
FERNET_KEY=replace-with-32-byte-base64-fernet-key

# ==============================
# Kafka (users service events/consumers)
# ==============================
KAFKA_SERVICE_NAME=identity
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_FILE=
KAFKA_SSL_CERT_FILE=
KAFKA_SSL_KEY_FILE=
KAFKA_SSL_KEY_PASSWORD=
KAFKA_CONSUMER_GROUP=identity-consumer
KAFKA_CONSUMER_TOPICS=identity.user,identity.company_profile,identity.membership
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_POLL_INTERVAL=1.0
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_MESSAGE_TIMEOUT_MS=10000
KAFKA_SESSION_TIMEOUT_MS=10000
KAFKA_HEARTBEAT_INTERVAL_MS=3000
KAFKA_PRODUCER_LINGER_MS=5
KAFKA_PRODUCER_ACKS=all
# Keep this false until kafka_reliability migrations have been applied in the target environment.
KAFKA_USE_OUTBOX=false
KAFKA_ENABLE_CONSUMER_IDEMPOTENCY=true
KAFKA_ENABLE_DLQ=true
KAFKA_COMMIT_FAILED_MESSAGES=true
KAFKA_DLQ_SUFFIX=.dlq
KAFKA_OUTBOX_BATCH_SIZE=100
KAFKA_OUTBOX_POLL_INTERVAL=2.0
KAFKA_OUTBOX_RETRY_DELAY_SECONDS=30

# For authenticated brokers, switch KAFKA_SECURITY_PROTOCOL to SASL_PLAINTEXT or SASL_SSL
# and set the SASL/SSL variables above.

# ==============================
# Optional AWS S3 storage
# ==============================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_STATIC_LOCATION=assessment/static

# ==============================
# Internal services
# ==============================
